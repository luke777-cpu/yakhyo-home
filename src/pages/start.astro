---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Button from '../components/Button.astro';
import Callout from '../components/Callout.astro';
import FAQ from '../components/FAQ.astro';
import { url } from '../lib/url';
import links from '../data/links.json';

const first = [
  { title: '약 먹는 시각을 등록합니다', detail: '평소 복용하는 시간을 넣어두면 매번 새로 입력하지 않아도 됩니다.' },
  { title: '약을 먹을 때 그 자리에서 기록합니다', detail: '나중에 떠올려 적으면 몇 분 단위의 간격이 흐려집니다.' },
  { title: '몸이 달라졌다고 느낄 때마다 출력을 남깁니다', detail: '하루에 여러 번이어도 좋고, 애매하면 애매한 대로 남겨도 됩니다.' },
  { title: '사흘쯤 지나면 그래프를 봅니다', detail: '하루치로는 잘 보이지 않습니다. 반복되는 형태는 며칠이 쌓여야 나타납니다.' },
];

const faq = [
  { q: '매번 기록해야 하나요?', a: '아닙니다. 하루 종일 붙잡고 있을 필요는 없습니다. 약을 먹은 시각과, 몸이 달라졌다고 느낀 순간 몇 번이면 곡선의 형태는 충분히 드러납니다.' },
  { q: '지금이 좋은 상태인지 나쁜 상태인지 모르겠습니다.', a: '판단하지 않아도 됩니다. 두 가지 중에 고르는 방식이 아니라 "지금 어느 정도인가"를 남기는 방식이라, 애매한 순간도 그대로 기록할 수 있습니다.' },
  { q: '기록이 서버로 올라가나요?', a: '아닙니다. 기록은 사용하는 기기 안에 남습니다. 이 홈페이지는 어떤 기록도 받지 않습니다. 기기를 바꿀 때를 위해 내보내기와 복원 기능이 있습니다.' },
  { q: '기록을 보고 약을 조절해도 되나요?', a: '기록은 상황을 설명하기 위한 자료입니다. 약의 종류·용량·복용 시간에 대한 판단은 담당 치료진과 상의해 주세요.' },
];
---
<BaseLayout
  title="시작하기"
  description="약효일지를 처음 시작할 때 무엇부터 하면 되는지, 며칠을 기록해야 곡선이 보이는지 안내합니다."
>
  <PageHead
    crumb="시작하기"
    title="처음 나흘만 기록해 보세요"
    lead="완벽하게 기록할 필요는 없습니다. 약을 먹은 시각과 몸이 달라진 순간만 남겨도 곡선의 형태는 드러납니다."
  />

  <div class="container">
    <div class="btn-row" style="margin-bottom: var(--sp-16)">
      {links.playStore && (
        <Button href={links.playStore} external block>Google Play에서 받기</Button>
      )}
      {links.app && (
        <Button href={links.app} variant={links.playStore ? 'secondary' : 'primary'} external block>
          {links.playStore ? '웹에서 바로 열기' : '약효일지 열기'}
        </Button>
      )}
      <Button href={url('/diary/')} variant="secondary" block>먼저 설명 읽기</Button>
    </div>

    <h2 class="section__title">시작하는 순서</h2>
    <ol class="checklist" style="margin-top: var(--sp-6)">
      {first.map((f) => (
        <li>
          <strong>{f.title}</strong>
          <span>{f.detail}</span>
        </li>
      ))}
    </ol>

    <div style="margin-top: var(--sp-16)">
      <h2 class="section__title">자주 묻는 것</h2>
      <div style="margin-top: var(--sp-6); max-width: var(--w-prose)">
        <FAQ items={faq} />
      </div>
    </div>

    <div style="margin-top: var(--sp-16)">
      <Callout tone="plain">
        <p>
          기록이 며칠 쌓이면 <a href={url('/graphs/')}>그래프 읽기</a>를 함께 보세요.
          곡선의 어느 부분을 보아야 하는지 정리해 두었습니다.
        </p>
      </Callout>
    </div>
  </div>
</BaseLayout>

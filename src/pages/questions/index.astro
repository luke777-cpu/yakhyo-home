---
/**
 * 질문 목록.
 *
 * 정적 페이지이고 목록은 브라우저에서 채운다.
 * 읽기는 로그인 없이도 된다(RLS 의 select 정책이 public).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { url } from '../../lib/url';
---
<BaseLayout
  title="질문게시판"
  description="약효 기록과 그래프 읽기에 대해 궁금한 점을 올리고 답을 주고받는 곳입니다."
>
  <PageHead
    title="질문게시판"
    lead="기록하다 막히는 곳, 그래프에서 헷갈리는 곳을 물어보세요. 읽는 것은 로그인 없이도 됩니다."
  />

  <div class="container">
    <div class="board">
      <div class="notice notice--info" style="margin-bottom: var(--sp-6)">
        여기는 <strong>기록 방법</strong>을 이야기하는 곳입니다.
        약의 용량이나 복용 시간에 대한 판단은 진료에서 상의하세요.
      </div>

      <div class="btn-row" style="margin-bottom: var(--sp-6)">
        <a class="btn btn--primary" href={url('/questions/new/')}>질문 쓰기</a>
        <a class="btn btn--secondary" href={url('/questions/mine/')} id="mine-link" hidden>내 글</a>
      </div>

      <div class="notice notice--error" id="err" hidden></div>
      <p class="skeleton" id="loading">불러오는 중…</p>
      <ul class="board__list" id="list" hidden></ul>
      <p class="board__empty" id="empty" hidden>아직 올라온 질문이 없습니다. 첫 질문을 남겨 보세요.</p>
    </div>
  </div>
</BaseLayout>

<script>
  import { getSupabase, isConfigured, SETUP_MESSAGE, friendlyError, escapeHtml, timeAgo, nicknameOf, countOf } from '../../lib/supabase';
  import { url } from '../../lib/url';

  const err = document.getElementById('err')!;
  const loading = document.getElementById('loading')!;
  const list = document.getElementById('list')!;
  const empty = document.getElementById('empty')!;
  const mineLink = document.getElementById('mine-link')!;

  function show(msg: string) { loading.hidden = true; err.textContent = msg; err.hidden = false; }

  const sb = getSupabase();
  if (!isConfigured || !sb) {
    show(SETUP_MESSAGE);
  } else {
    sb.auth.getSession().then(({ data: { session } }) => { if (session?.user) mineLink.hidden = false; });

    (async () => {
      const { data, error } = await sb
        .from('posts')
        .select('id, title, created_at, profiles(nickname), comments(count)')
        // 정책상 작성자에게는 자기 지운 글도 보인다. 목록에서는 명시적으로 거른다.
        .is('deleted_at', null)
        .order('created_at', { ascending: false })
        .limit(50);

      loading.hidden = true;
      if (error) { show(friendlyError(error, '목록을 불러오지 못했습니다.')); return; }
      if (!data || data.length === 0) { empty.hidden = false; return; }

      // 사용자가 쓴 값은 전부 escape 한다. 게시판은 서식 없는 글만 받는다.
      list.innerHTML = data.map((p: any) => {
        const nick = nicknameOf(p);
        const count = countOf(p);
        return `<li class="board__item">
          <a class="board__link" href="${url('/questions/view/')}?id=${encodeURIComponent(p.id)}">
            <div class="board__title">${escapeHtml(p.title)}${count > 0 ? ` <span style="color: var(--c-primary)">[${count}]</span>` : ''}</div>
            <div class="board__meta"><span>${escapeHtml(nick)}</span><span>${timeAgo(p.created_at)}</span></div>
          </a>
        </li>`;
      }).join('');
      list.hidden = false;
    })();
  }
</script>

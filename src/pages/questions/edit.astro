---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import BoardNotice from '../../components/BoardNotice.astro';
import { url } from '../../lib/url';
---
<BaseLayout title="질문 수정" description="본인이 올린 질문을 수정합니다.">
  <PageHead crumb="질문게시판" crumbHref={url('/questions/')} title="질문 수정" />

  <div class="container">
    <div class="board">
      <BoardNotice />
      <div class="notice notice--error" id="err" hidden></div>
      <p class="skeleton" id="loading">불러오는 중…</p>

      <form class="form" id="form" novalidate hidden>
        <div class="field">
          <label class="field__label" for="title">
            제목 <span class="field__count"><span id="tc">0</span>/120</span>
          </label>
          <input class="input" id="title" type="text" required minlength="2" maxlength="120" />
        </div>
        <div class="field">
          <label class="field__label" for="body">
            내용 <span class="field__count"><span id="bc">0</span>/5000</span>
          </label>
          <textarea class="textarea" id="body" required minlength="2" maxlength="5000"></textarea>
        </div>
        <div class="btn-row">
          <button class="btn btn--primary" type="submit" id="submit">저장</button>
          <a class="btn btn--secondary" id="cancel" href={url('/questions/')}>취소</a>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  import { getSupabase, isConfigured, SETUP_MESSAGE, absoluteUrl, friendlyError } from '../../lib/supabase';

  const $ = (id: string) => document.getElementById(id)!;
  const err = $('err'), loading = $('loading'), form = $('form') as HTMLFormElement;
  const title = $('title') as HTMLInputElement, body = $('body') as HTMLTextAreaElement;
  const submit = $('submit') as HTMLButtonElement;
  function show(msg: string) { loading.hidden = true; err.textContent = msg; err.hidden = false; }

  const bind = (el: HTMLInputElement | HTMLTextAreaElement, out: string) => {
    const o = $(out); const upd = () => { o.textContent = String(el.value.length); };
    el.addEventListener('input', upd); upd();
  };
  bind(title, 'tc'); bind(body, 'bc');

  const postId = new URLSearchParams(location.search).get('id');
  const sb = getSupabase();

  if (!isConfigured || !sb) show(SETUP_MESSAGE);
  else if (!postId) show('주소에 글 번호가 없습니다.');
  else void load();

  async function load() {
    const { data: { session } } = await sb!.auth.getSession();
    if (!session?.user) { location.replace(absoluteUrl('/login/')); return; }

    const { data, error } = await sb!.from('posts')
      .select('id, title, body, author_id').eq('id', postId).is('deleted_at', null).maybeSingle();

    loading.hidden = true;
    if (error) { show(friendlyError(error, '글을 불러오지 못했습니다.')); return; }
    if (!data) { show('없는 글이거나 지워진 글입니다.'); return; }
    // 화면에서도 막고 RLS 에서도 막힌다. 두 겹으로 두는 편이 안전하다.
    if (data.author_id !== session.user.id) { show('본인이 쓴 글만 수정할 수 있습니다.'); return; }

    title.value = data.title; body.value = data.body;
    title.dispatchEvent(new Event('input')); body.dispatchEvent(new Event('input'));
    ($('cancel') as HTMLAnchorElement).href = `${absoluteUrl('/questions/view/')}?id=${encodeURIComponent(postId!)}`;
    form.hidden = false;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.hidden = true;
    const t = title.value.trim(), b = body.value.trim();
    if (t.length < 2 || b.length < 2) { show('제목과 내용을 채워 주세요.'); return; }

    submit.disabled = true; submit.textContent = '저장 중…';
    const { error } = await sb!.from('posts').update({ title: t, body: b }).eq('id', postId);
    if (error) {
      submit.disabled = false; submit.textContent = '저장';
      show(friendlyError(error, '저장하지 못했습니다.'));
      return;
    }
    location.replace(`${absoluteUrl('/questions/view/')}?id=${encodeURIComponent(postId!)}`);
  });
</script>

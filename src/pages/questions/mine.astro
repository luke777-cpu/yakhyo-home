---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { url } from '../../lib/url';
---
<BaseLayout title="내 글" description="내가 올린 질문 목록입니다.">
  <PageHead crumb="질문게시판" crumbHref={url('/questions/')} title="내 글" />
  <div class="container">
    <div class="board">
      <div class="notice notice--error" id="err" hidden></div>
      <p class="skeleton" id="loading">불러오는 중…</p>
      <ul class="board__list" id="list" hidden></ul>
      <p class="board__empty" id="empty" hidden>아직 올린 질문이 없습니다.</p>
    </div>
  </div>
</BaseLayout>

<script>
  import { isConfigured, SETUP_MESSAGE, absoluteUrl, currentUser, listMyPosts, friendlyError, escapeHtml, timeAgo , isHidden, HIDDEN_POST_TEXT } from '../../lib/firebase';
  import { url } from '../../lib/url';

  const $ = (id: string) => document.getElementById(id)!;
  const err = $('err'), loading = $('loading'), list = $('list'), empty = $('empty');
  const show = (msg: string) => { loading.hidden = true; err.textContent = msg; err.hidden = false; };

  if (!isConfigured) show(SETUP_MESSAGE);
  else {
    void (async () => {
      try {
        const u = await currentUser();
        if (!u) { location.replace(absoluteUrl('/login/')); return; }
        const rows = await listMyPosts(u.uid);
        loading.hidden = true;
        if (!rows.length) { empty.hidden = false; return; }
        list.innerHTML = rows.map((p) => `
          <li class="board__item">
            <a class="board__link" href="${url('/questions/view/')}?id=${encodeURIComponent(p.id)}">
              <div class="board__title">${isHidden(p) ? escapeHtml(HIDDEN_POST_TEXT) : escapeHtml(p.title)}</div>
              <div class="board__meta"><span>${timeAgo(p.createdAt)}</span></div>
            </a></li>`).join('');
        list.hidden = false;
      } catch (e) { show(friendlyError(e, '목록을 불러오지 못했습니다.')); }
    })();
  }
</script>

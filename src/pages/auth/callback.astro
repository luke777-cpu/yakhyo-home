---
/**
 * OAuth / 메일 링크가 돌아오는 곳.
 *
 * 이 주소를 Supabase 와 카카오·Google 콘솔에 redirect URI 로 등록한다.
 * 하는 일은 세션이 자리잡을 때까지 기다렸다가, 닉네임 유무에 따라 보내는 것뿐이다.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
---
<BaseLayout title="로그인 확인 중" description="로그인 처리 중입니다.">
  <PageHead title="로그인 확인 중" />
  <div class="container">
    <div class="auth">
      <p class="skeleton" id="msg">잠시만 기다려 주세요…</p>
      <div class="notice notice--error" id="err" hidden></div>
    </div>
  </div>
</BaseLayout>

<script>
  import { getSupabase, isConfigured, SETUP_MESSAGE, absoluteUrl, friendlyError, getProfile } from '../../lib/supabase';

  const msg = document.getElementById('msg')!;
  const err = document.getElementById('err')!;

  function fail(text: string) {
    msg.hidden = true;
    err.textContent = text;
    err.hidden = false;
  }

  const sb = getSupabase();
  if (!isConfigured || !sb) {
    fail(SETUP_MESSAGE);
  } else {
    // detectSessionInUrl 이 URL 의 코드를 세션으로 바꾸는 데 한 박자 걸린다.
    // onAuthStateChange 로 기다리되, 영영 안 오는 경우를 대비해 시간 제한을 둔다.
    let done = false;

    const go = async (userId: string) => {
      if (done) return;
      done = true;
      const profile = await getProfile(sb, userId);
      location.replace(profile ? absoluteUrl('/questions/') : absoluteUrl('/profile/setup/'));
    };

    sb.auth.onAuthStateChange((_event, session) => {
      if (session?.user) void go(session.user.id);
    });

    sb.auth.getSession().then(({ data: { session } }) => {
      if (session?.user) void go(session.user.id);
    });

    setTimeout(() => {
      if (done) return;
      // URL 에 제공자가 보낸 오류가 실려 오는 경우가 있다.
      const q = new URLSearchParams(location.hash.slice(1) || location.search);
      const desc = q.get('error_description') ?? q.get('error');
      fail(desc
        ? friendlyError({ message: desc }, `로그인하지 못했습니다: ${desc}`)
        : '로그인 확인이 끝나지 않았습니다. 다시 시도해 주세요.');
    }, 6000);
  }
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import DayCurve from '../components/DayCurve.astro';
import Button from '../components/Button.astro';
import Timeline from '../components/Timeline.astro';
import VideoCard from '../components/VideoCard.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';
import { SITE } from '../lib/site';

import dayTypical from '../data/curves/day-typical.json';
import singleDose from '../data/curves/single-dose.json';
import symptoms from '../data/symptoms.json';
import concepts from '../data/concepts.json';
import videos from '../data/videos.json';
import series from '../data/series.json';
import type { CurveData } from '../lib/curve';

const conceptBySlug = new Map(concepts.map((c) => [c.slug, c]));
const homeConcepts = ['on', 'off', 'delayed-on', 'incomplete-on', 'wearing-off', 'dyskinesia']
  .map((slug) => conceptBySlug.get(slug))
  .filter(Boolean) as typeof concepts;

const publishedVideos = videos.items.filter((v) => v.youtubeId && v.status === 'published').slice(0, 3);

const dayCurve = dayTypical as CurveData;
const doseCurve = singleDose as CurveData;

const steps = [
  { title: '기록한다', desc: '지금 몸이 어느 정도로 움직이는지, 언제 약을 먹었는지를 그때그때 남깁니다.' },
  { title: '곡선이 보인다', desc: '흩어진 기록이 하루를 가로지르는 하나의 곡선으로 모입니다.' },
  { title: '패턴을 이해한다', desc: '며칠이 쌓이면 반복되는 형태와 달라진 날이 눈에 들어옵니다.' },
];

const timeline = [
  { time: '07:00', label: '약 복용', note: '먹은 시각을 그 자리에서 남깁니다' },
  { time: '08:10', label: '첫 상승', note: '몸이 달라지기 시작했다고 느낀 시점' },
  { time: '09:00', label: '최고 출력', note: '이날 가장 잘 움직였던 시간대' },
  { time: '11:20', label: '하강', note: '다시 무거워지기 시작한 시점' },
];
---
<BaseLayout title={SITE.title} description={SITE.description} bareTitle>
  <!-- 1 — HERO : 모바일에서는 제목 → 설명 → CTA → 그래프 순서로 쌓인다 -->
  <div class="hero">
    <div class="container hero__inner">
      <div>
        <h1 class="hero__title">내 약은<br />언제 듣고,<br />언제 떨어질까요?</h1>
        <p class="hero__lead">파킨슨 약효 변화를 하루의 곡선으로 기록합니다.</p>
        <div class="btn-row hero__actions">
          <Button href={url('/start/')} block>약효일지 시작하기</Button>
          <Button href={url('/diary/')} variant="secondary" block>기록 방법 보기</Button>
        </div>
      </div>

      <DayCurve
        curve={dayCurve}
        variant="compact"
        title="하루 동안 오르내리는 출력 변화의 예시"
        caption="교육을 위해 만든 예시 곡선입니다. 실제 곡선은 사람마다 다릅니다."
      />
    </div>
  </div>

  <!-- 새 버전 안내 — 첫 화면 바로 아래에서 잘 보이게 고정 -->
  <div class="container" style="margin-top: var(--sp-6); margin-bottom: var(--sp-6)">
    <a
      href={url('/update-2-17-0/')}
      class="card"
      style="display:block; border:2px solid var(--accent); background:color-mix(in srgb,var(--accent) 8%,var(--surface)); text-decoration:none"
      aria-label="약효일지 2.17.0 업데이트와 위젯 설치 방법 보기"
    >
      <p class="card__eyebrow" style="color:var(--accent-ink)">NEW · 2026.08.27</p>
      <h2 class="card__title" style="font-size:clamp(20px,4vw,28px)">2.17.0 업데이트 · 홈 화면 위젯 2종 추가</h2>
      <p class="card__desc">앱을 열지 않고 출력과 방향을 기록하고, 증상·생활·메모 화면으로 바로 갈 수 있습니다.</p>
      <p class="card__foot" style="margin-top:var(--sp-4); color:var(--accent-ink); font-weight:800">새 기능과 위젯 설치·사용법 보기 →</p>
    </a>
  </div>

  <!-- 2 — 핵심 개념 -->
  <Section sunken eyebrow="개념" title="기록에서 이해까지, 세 단계">
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <span class="step__num" aria-hidden="true">{i + 1}</span>
          <h3 class="step__title">{s.title}</h3>
          <p class="step__desc">{s.desc}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- 3 — 실제 하루 곡선 -->
  <Section
    eyebrow="어느 하루"
    title="한 번의 복용이 지나가는 모습"
    lead="약을 먹은 시각과 몸이 달라진 시각을 함께 남기면, 하루가 이런 형태로 남습니다."
  >
    <div class="daystory">
      <DayCurve
        curve={doseCurve}
        variant="full"
        title="07시 복용 뒤의 출력 변화 예시"
        caption="교육을 위해 만든 예시 곡선입니다. 특정 약이나 용량의 반응을 나타내지 않습니다."
      />
      <div>
        <Timeline items={timeline} label="복용과 출력 변화의 시각" />
        <p class="section__lead" style="font-size: var(--fs-sm)">
          같은 하루를 "괜찮았다 / 힘들었다"로만 남기면 이 네 개의 시각은 사라집니다.
          시각이 남으면 다음에 무엇이 달라졌는지 비교할 수 있습니다.
        </p>
        <p style="margin-top: var(--sp-4)">
          <a class="link-arrow" href={url('/graphs/')}>그래프 읽는 법 보기 <Icon name="arrow-right" size={18} /></a>
        </p>
      </div>
    </div>
  </Section>

  <!-- 4 — 내가 겪는 현상 찾기 (진단이 아니라 용어로 가는 길잡이) -->
  <Section
    sunken
    eyebrow="현상 찾기"
    title="지금 겪는 변화와 비슷한 것이 있나요?"
    lead="아래는 자주 쓰이는 표현들입니다. 상태를 판단하기 위한 것이 아니라, 그 현상을 부르는 이름과 설명으로 가는 길잡이입니다."
  >
    <ul class="rowlink-list rowlink-list--2col">
      {symptoms.map((s) => {
        const concept = conceptBySlug.get(s.concept);
        const ready = concept?.status === 'published';
        return (
          <li>
            {ready ? (
              <a class="rowlink" href={url(`/understand/${s.concept}/`)}>
                <span class="rowlink__text">{s.text}<span class="rowlink__hint">{s.hint}</span></span>
                <Icon name="arrow-right" size={18} class="rowlink__arrow" />
              </a>
            ) : (
              <span class="rowlink">
                <span class="rowlink__text">{s.text}<span class="rowlink__hint">{s.hint}</span></span>
                <span class="badge">준비 중</span>
              </span>
            )}
          </li>
        );
      })}
    </ul>
  </Section>

  <!-- 5 — 약효일지 소개 -->
  <Section eyebrow="약효일지" title="왜 이런 기록이 필요한가">
    <div class="prose">
      <p>
        하루가 지나면 남는 것은 "오늘은 괜찮았다" 정도입니다.
        몇 시에 약을 먹었고, 언제부터 몸이 달라졌고, 얼마나 유지됐는지는 며칠만 지나도 흐려집니다.
      </p>
      <p>
        약효일지는 그 세 가지를 같은 시간축 위에 올려둡니다.
        출력의 정도, 복용 시각, 그리고 그 사이에 있었던 일을 함께 남기면 하루가 하나의 곡선이 됩니다.
        곡선이 며칠 쌓이면 그날만의 일과 반복되는 형태가 나뉘어 보이기 시작합니다.
      </p>
      <p>
        상태를 두 가지로 나누어 고르지 않아도 됩니다.
        "지금 어느 정도인가"를 남기는 것만으로 충분합니다.
      </p>
    </div>
    <p style="margin-top: var(--sp-8)">
      <a class="link-arrow" href={url('/diary/')}>약효일지 자세히 보기 <Icon name="arrow-right" size={18} /></a>
    </p>
  </Section>

  <!-- 6 — 배우기 -->
  <Section
    sunken
    eyebrow="배우기"
    title="자주 쓰이는 용어부터"
    lead="진료실에서 오가는 말들이 그래프의 어느 부분을 가리키는지 정리했습니다."
  >
    <ul class="termlist">
      {homeConcepts.map((c) => {
        const ready = c.status === 'published';
        const Tag = ready ? 'a' : 'div';
        return (
          <li class={`termlist__item ${ready ? '' : 'termlist__item--pending'}`}>
            <Tag class="termlist__row" href={ready ? url(`/understand/${c.slug}/`) : undefined}>
              <span>
                <span class="termlist__term">{c.term}</span>
                <span class="termlist__title">{c.title}</span>
                <span class="termlist__desc">{c.summary}</span>
              </span>
              {ready
                ? <span class="termlist__state" aria-hidden="true">→</span>
                : <span class="badge">준비 중</span>}
            </Tag>
          </li>
        );
      })}
    </ul>
    <p style="margin-top: var(--sp-8)">
      <a class="link-arrow" href={url('/understand/')}>약효 이해하기 전체 보기 <Icon name="arrow-right" size={18} /></a>
    </p>
  </Section>

  <!-- 7 — 몸으로 쓰는 두 연재 -->
  <Section eyebrow="연재" title="몸으로 배우는 두 가지 배경 지식">
    <div class="grid grid--2">
      <a class="card" href={url('/learn/series/pharmacology/')} data-gtag-event="course_card_click" data-gtag-course-name="pharmacology">
        <p class="card__eyebrow">약리학</p>
        <h3 class="card__title">{series.pharmacology.title}</h3>
        <p class="card__desc">{series.pharmacology.summary}</p>
        <p class="card__foot">약리학 강좌 보기 →</p>
      </a>
      <a class="card" href={url('/learn/series/neuroanatomy/')} data-gtag-event="course_card_click" data-gtag-course-name="neuroanatomy">
        <p class="card__eyebrow">신경해부학</p>
        <h3 class="card__title">{series.neuroanatomy.title}</h3>
        <p class="card__desc">{series.neuroanatomy.summary}</p>
        <p class="card__foot">신경해부학 강좌 보기 →</p>
      </a>
    </div>
  </Section>

  <!-- 8 — YouTube : 올라온 영상이 있을 때만 카드로 보여준다.
       아직 없을 때 빈 썸네일 카드를 늘어놓지 않기 위한 분기다. -->
  <Section sunken eyebrow="영상" title="보면서 이해하기">
    {publishedVideos.length > 0 ? (
      <div class="grid grid--3">
        {publishedVideos.map((v) => (
          <VideoCard youtubeId={v.youtubeId} title={v.title} summary={v.summary} publishedAt={v.publishedAt} />
        ))}
      </div>
    ) : (
      <ul class="termlist">
        {videos.items.slice(0, 3).map((v) => (
          <li class="termlist__item termlist__item--pending">
            <div class="termlist__row">
              <span>
                <span class="termlist__title">{v.title}</span>
                <span class="termlist__desc">{v.summary}</span>
              </span>
              <span class="badge">준비 중</span>
            </div>
          </li>
        ))}
      </ul>
    )}
  </Section>

  <!-- 9 — 마지막 CTA -->
  <div class="finalcta">
    <div class="container">
      <h2 class="finalcta__title">기록이 쌓이면,<br />하루가 다르게 보이기 시작합니다.</h2>
      <div class="btn-row finalcta__actions">
        <Button href={url('/start/')} block>약효일지 시작하기</Button>
      </div>
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import TocList from '../../components/TocList.astro';
import Callout from '../../components/Callout.astro';
import Button from '../../components/Button.astro';
import DayCurve from '../../components/DayCurve.astro';
import { url } from '../../lib/url';
import topics from '../../data/diary-topics.json';
import singleDose from '../../data/curves/single-dose.json';
import type { CurveData } from '../../lib/curve';

const items = topics.map((t) => ({
  title: t.title,
  summary: t.summary,
  href: url(`/diary/${t.slug}/`),
  status: t.status as 'published' | 'preparing',
}));
---
<BaseLayout
  title="약효일지"
  description="약효일지는 파킨슨 약효 변화를 하루의 곡선으로 남기는 기록 앱입니다. 무엇을 기록하고, 그 기록이 어떻게 그래프가 되는지 정리했습니다."
>
  <PageHead
    crumb="약효일지"
    title="약효일지란 무엇인가"
    lead="약효일지는 하루 동안의 약효 변화를 기록하는 앱입니다. 상태를 두 가지로 나누어 고르는 대신, 지금 어느 정도인지를 남기고 그것이 곡선이 되도록 만들어졌습니다."
  />

  <div class="container">
    <div class="prose">
      <h2>무엇을 기록하나</h2>
      <p>
        기록은 세 가지로 이루어집니다. <strong>출력</strong> — 지금 몸이 어느 정도로 움직이는가.
        <strong>약</strong> — 무엇을 언제 먹었는가. <strong>이벤트</strong> — 식사, 활동, 이상운동처럼
        곡선에 영향을 줄 수 있는 일.
      </p>
      <p>
        세 가지가 같은 시간축 위에 놓이면, 흩어진 메모가 아니라 하루의 형태가 남습니다.
      </p>
    </div>

    <div style="margin-top: var(--sp-12); max-width: 820px">
      <DayCurve
        curve={singleDose as CurveData}
        variant="full"
        title="기록이 곡선이 되는 방식의 예시"
        caption="복용 시각(삼각형)과 출력 기록이 하나의 그림으로 합쳐집니다. 교육을 위해 만든 예시 곡선입니다."
      />
    </div>

    <div class="prose" style="margin-top: var(--sp-16)">
      <h2>왜 두 가지로 나누지 않는가</h2>
      <p>
        약효 변화를 켜짐과 꺼짐으로 나누어 기록하면, 그 사이의 넓은 구간이 사라집니다.
        올라오는 중인지, 올라왔지만 평소보다 낮은지, 내려오는 중인지가 모두 하나로 뭉쳐집니다.
        정작 진료실에서 필요한 정보는 대부분 그 사이에 있습니다.
      </p>
      <p>
        그래서 약효일지는 상태를 고르게 하지 않고 정도를 남기게 합니다.
        어느 쪽인지 판단하기 어려운 순간에도 기록을 이어갈 수 있습니다.
      </p>

      <h2>기록은 어디에 남는가</h2>
      <p>
        기록은 사용하는 기기 안에 남습니다. 이 홈페이지는 기록을 받거나 보관하지 않습니다.
        기기를 바꾸거나 초기화할 때를 위해 내보내기와 복원 기능이 있습니다.
      </p>
    </div>

    <div style="margin-top: var(--sp-16)">
      <h2 class="section__title">순서대로 읽기</h2>
      <p class="section__lead">처음이라면 위에서부터 차례로 보시면 됩니다.</p>
      <div style="margin-top: var(--sp-8)">
        <TocList items={items} />
      </div>
      <p class="section__lead" style="font-size: var(--fs-sm); margin-top: var(--sp-8)">
        각 항목의 자세한 글은 준비 중입니다.
      </p>
    </div>

    <div style="margin-top: var(--sp-16)">
      <Callout>
        <p class="callout__title">먼저 써 보고 싶다면</p>
        <p>설치 없이 웹에서 바로 열어 볼 수 있습니다.</p>
        <p style="margin-top: var(--sp-6)">
          <Button href={url('/start/')}>약효일지 시작하기</Button>
        </p>
      </Callout>
    </div>
  </div>
</BaseLayout>

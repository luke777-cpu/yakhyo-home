---
import { getCollection, render } from 'astro:content';
import EnTermLayout from '../../../layouts/EnTermLayout.astro';
import type { CurveData } from '../../../lib/curve';

export async function getStaticPaths() {
  const entries = await getCollection('enTerms');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// 곡선 데이터는 한국어 글과 같은 파일을 함께 쓴다. 그림은 언어와 무관하게 같다.
const curves = import.meta.glob<{ default: CurveData }>('../../../data/curves/*.json', { eager: true });
const curve = entry.data.curve
  ? curves[`../../../data/curves/${entry.data.curve}.json`]?.default
  : undefined;
---
<EnTermLayout data={entry.data} curve={curve}>
  <Content />
</EnTermLayout>

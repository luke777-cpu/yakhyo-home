---
import { getCollection, render } from 'astro:content';
import EnBaseLayout from '../../../layouts/EnBaseLayout.astro';
import SeriesToc from '../../../components/SeriesToc.astro';
import PrevNextNav from '../../../components/PrevNextNav.astro';
import enSeries from '../../../data/en/series.json';
import { seriesItemViews, seriesPrevNext, type Series } from '../../../lib/series';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  const entries = await getCollection('enLearn');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, lead, related } = entry.data;
// 한국어 원문 경로 — slug 가 같으므로 그대로 연결된다.
const koPath = `/learn/${entry.id}/`;

// 이 글이 「몸으로 쓰는 약리학」·「몸으로 배우는 신경해부학」 연재의 한 편이면
// slug 접두사로 시리즈를 찾아 목차와 이전/다음 이동을 계산한다.
// enLearn 은 series 프론트매터 없이 slug 접두사만으로 연재를 식별한다 (en/learn/index.astro 와 동일한 규칙).
const seriesKey = entry.id.startsWith('body-pharmacology')
  ? 'pharmacology'
  : entry.id.startsWith('body-neuroanatomy')
    ? 'neuroanatomy'
    : undefined;
const seriesInfo = seriesKey ? (enSeries as Record<string, Series>)[seriesKey] : undefined;
let series: { title: string; items: ReturnType<typeof seriesItemViews>; prev: ReturnType<typeof seriesItemViews>[number] | null; next: ReturnType<typeof seriesItemViews>[number] | null; key: string } | undefined;
if (seriesInfo) {
  const written = new Set((await getCollection('enLearn')).map((e) => e.id));
  const items = seriesItemViews(seriesInfo, written, url('/en/learn/'), entry.id);
  const { prev, next } = seriesPrevNext(seriesInfo, written, url('/en/learn/'), entry.id);
  series = { title: seriesInfo.title, items, prev, next, key: seriesKey as string };
}
---
<EnBaseLayout title={title} description={description} koPath={koPath}>
  <div class="container">
    <article class="article">
      <nav class="crumb"><a href={url('/en/')}>English</a> · <a href={url('/en/learn/')}>Learn</a></nav>
      {series && (
        <div style="margin-bottom: var(--sp-10, 2.5rem)">
          <SeriesToc title={series.title} items={series.items} pendingLabel="In preparation" currentLabel="Now reading" />
        </div>
      )}
      <h1>{title}</h1>
      {lead && <p class="article__lead">{lead}</p>}
      <div class="article__body">
        <Content />
      </div>
      {related.length > 0 && (
        <aside class="related">
          <h2>Related articles</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={url(r.href)}>{r.label}</a>
                {r.note && <span class="related__note"> — {r.note}</span>}
              </li>
            ))}
          </ul>
        </aside>
      )}
      {series && (
        <PrevNextNav prev={series.prev} next={series.next} navLabel="Series navigation" seriesName={series.key} currentArticle={entry.id} />
      )}
    </article>
  </div>
</EnBaseLayout>

<style>
  .article { max-width: 720px; margin: 0 auto; padding: var(--sp-10, 2.5rem) 0 var(--sp-12, 4rem); }
  .crumb { font-size: 0.85rem; color: var(--c-text-weak, #777); margin-bottom: 1rem; }
  .crumb a { color: inherit; }
  h1 { line-height: 1.3; margin: 0 0 0.9rem; }
  .article__lead { color: var(--c-text-weak, #666); font-size: 1.05rem; line-height: 1.8; margin: 0 0 2rem; }
  .article__body { line-height: 1.85; }
  .article__body :global(h2) { margin-top: 2.4rem; }
  .article__body :global(figure.article-figure) { margin: 1.6rem 0; }
  .article__body :global(figure.article-figure img) { width: 100%; height: auto; }
  .article__body :global(figcaption) { font-size: 0.85rem; color: var(--c-text-weak, #777); margin-top: 0.5rem; }
  .article__body :global(blockquote) { border-left: 3px solid var(--c-line, #ddd); margin: 2rem 0 0; padding: 0.2rem 0 0.2rem 1rem; color: var(--c-text-weak, #666); font-size: 0.92rem; }
  .related { margin-top: 3rem; border-top: 1px solid var(--c-line, #e5e0d8); padding-top: 1.4rem; }
  .related h2 { font-size: 1rem; margin: 0 0 0.7rem; }
  .related ul { margin: 0; padding-left: 1.1rem; }
  .related li { margin-bottom: 0.4rem; }
  .related__note { color: var(--c-text-weak, #777); font-size: 0.88rem; }
</style>

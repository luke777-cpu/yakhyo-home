---
import { getCollection, render } from 'astro:content';
import EnGraphLayout from '../../../layouts/EnGraphLayout.astro';
import type { CurveData } from '../../../lib/curve';

export async function getStaticPaths() {
  const entries = await getCollection('enGraphs');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// 곡선 데이터는 한국어 글과 같은 파일을 함께 쓴다. 그림은 언어와 무관하게 같다.
const curves = import.meta.glob<{ default: CurveData }>('../../../data/curves/*.json', { eager: true });
const curve = curves[`../../../data/curves/${entry.data.curve}.json`]!.default;
// 한국어 원문 경로 — slug 가 같으므로 그대로 연결된다.
const koPath = `/graphs/${entry.id}/`;
---
<EnGraphLayout data={entry.data} curve={curve} koPath={koPath}>
  <Content />
</EnGraphLayout>

---
import { getCollection, render } from 'astro:content';
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import type { CurveData } from '../../lib/curve';

export async function getStaticPaths() {
  const entries = await getCollection('understand');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// 곡선 데이터는 파일 이름으로 가져온다. 없으면 그래프 없이 렌더된다.
const curves = import.meta.glob<{ default: CurveData }>('../../data/curves/*.json', { eager: true });
const curve = entry.data.curve
  ? curves[`../../data/curves/${entry.data.curve}.json`]?.default
  : undefined;
---
<ConceptLayout data={entry.data} curve={curve}>
  <Content />
</ConceptLayout>

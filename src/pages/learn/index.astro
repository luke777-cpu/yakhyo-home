---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Section from '../../components/Section.astro';
import VideoCard from '../../components/VideoCard.astro';
import TocList from '../../components/TocList.astro';
import categories from '../../data/learn-categories.json';
import articles from '../../data/articles.json';
import videos from '../../data/videos.json';
import series from '../../data/series.json';
import { url } from '../../lib/url';

// 글이 없는데 published로 표시된 항목이 있으면 빌드를 멈춘다.
// 눌리는 링크가 빈 페이지로 이어지는 상태를 만들지 않기 위한 장치다.
const written = new Set((await getCollection('learn')).map((e) => e.id));
const missing = articles.filter((a) => a.status === 'published' && !written.has(a.slug));
if (missing.length > 0) {
  throw new Error(
    `src/content/learn/ 에 글이 없는데 published로 표시된 항목: ${missing.map((a) => a.slug).join(', ')}`,
  );
}

const byCategory = categories
  .filter((c) => c.slug !== 'video')
  .map((c) => ({
    ...c,
    items: articles
      .filter((a) => a.category === c.slug)
      .map((a) => ({
        title: a.title,
        summary: a.summary,
        href: a.status === 'published' ? url(`/learn/${a.slug}/`) : null,
        status: a.status as 'published' | 'preparing',
      })),
  }))
  .filter((c) => c.items.length > 0);
---
<BaseLayout
  title="배우기"
  description="3분 약효교실, 실제 그래프 읽기, 사용자 질문, 파킨슨 약리학, 신경해부학 — 약효 변동을 이해하는 데 필요한 배경 지식을 모았습니다."
>
  <PageHead
    crumb="배우기"
    title="배우기"
    lead="약효 변동을 이해하는 데 필요한 내용을 주제별로 모읍니다. 짧게 읽는 글과 영상이 함께 올라갑니다."
  />

  <div class="container">
    <!-- 빠른 진입 — 긴 목록을 내려가기 전에 먼저 큰 구조를 고를 수 있게 한다 -->
    <div class="grid grid--3">
      <a class="card" href={url('/learn/map/')} data-gtag-event="course_card_click" data-gtag-course-name="learning_map">
        <p class="card__eyebrow">전체 구조</p>
        <h2 class="card__title">학습지도</h2>
        <p class="card__desc">약효일지의 기록, 그래프, 배우기, 앱 안내를 한눈에 봅니다.</p>
      </a>
      <a class="card" href={url('/learn/series/pharmacology/')} data-gtag-event="course_card_click" data-gtag-course-name="pharmacology">
        <p class="card__eyebrow">연재</p>
        <h2 class="card__title">{series.pharmacology.title}</h2>
        <p class="card__desc">{series.pharmacology.summary}</p>
      </a>
      <a class="card" href={url('/learn/series/neuroanatomy/')} data-gtag-event="course_card_click" data-gtag-course-name="neuroanatomy">
        <p class="card__eyebrow">연재</p>
        <h2 class="card__title">{series.neuroanatomy.title}</h2>
        <p class="card__desc">{series.neuroanatomy.summary}</p>
      </a>
    </div>

    {byCategory.map((c) => (
      <section id={c.slug} style="margin-top: var(--sp-16); scroll-margin-top: var(--sp-16)">
        <h2 class="section__title">{c.title}</h2>
        <p class="section__lead">{c.summary}</p>
        <div style="margin-top: var(--sp-6)">
          <TocList items={c.items} numbered={false} />
        </div>
      </section>
    ))}
  </div>

  <Section title="영상" lead="같은 내용을 영상으로 보고 싶을 때." class="section--top">
    <div class="grid grid--3">
      {videos.items.map((v) => (
        <VideoCard youtubeId={v.youtubeId} title={v.title} summary={v.summary} publishedAt={v.publishedAt} />
      ))}
    </div>
  </Section>
</BaseLayout>

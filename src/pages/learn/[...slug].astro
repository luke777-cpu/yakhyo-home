---
import { getCollection, render } from 'astro:content';
import LearnLayout from '../../layouts/LearnLayout.astro';
import categories from '../../data/learn-categories.json';
import articles from '../../data/articles.json';
import type { CurveData } from '../../lib/curve';

export async function getStaticPaths() {
  const entries = await getCollection('learn');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// 글의 분류는 목록 데이터(articles.json) 한 곳에서만 정한다.
// 목록에 없는 글이 페이지로만 존재하는 상태를 막기 위해 여기서 빌드를 멈춘다.
const listed = articles.find((a) => a.slug === entry.id);
if (!listed) {
  throw new Error(`src/data/articles.json 에 "${entry.id}" 항목이 없습니다. 목록에 먼저 추가해 주세요.`);
}
const category = categories.find((c) => c.slug === listed.category);
if (!category) {
  throw new Error(`learn-categories.json 에 "${listed.category}" 분류가 없습니다.`);
}

// 곡선 데이터는 파일 이름으로 가져온다. 없으면 그래프 없이 렌더된다.
const curves = import.meta.glob<{ default: CurveData }>('../../data/curves/*.json', { eager: true });
const curve = entry.data.curve
  ? curves[`../../data/curves/${entry.data.curve}.json`]?.default
  : undefined;
---
<LearnLayout data={entry.data} category={category} curve={curve}>
  <Content />
</LearnLayout>

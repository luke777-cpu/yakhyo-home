---
/**
 * "배우기" 글의 공통 틀.
 * 하나의 조건이 곡선을 어떻게 흔드는지 읽는 글이므로, 순서를 개념 글과 같은 이유로 고정한다.
 *   1 한 줄 요약 → 2 그래프로 보면 → 3 흔히 하는 말 → 4 왜 그럴 수 있는가
 *   → 5 며칠만 기록해 보기 → 6 진료에서 → 7 자주 묻는 것 → 8 관련 글
 *
 * 글의 본문(마크다운)은 그래프 바로 아래에 들어간다. 그래프가 없으면 맨 위에 온다.
 */
import BaseLayout from './BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import DayCurve from '../components/DayCurve.astro';
import Callout from '../components/Callout.astro';
import FAQ from '../components/FAQ.astro';
import RelatedContent from '../components/RelatedContent.astro';
import SeriesToc from '../components/SeriesToc.astro';
import PrevNextNav from '../components/PrevNextNav.astro';
import Button from '../components/Button.astro';
import { url } from '../lib/url';
import type { CurveData } from '../lib/curve';
import type { SeriesItemView } from '../lib/series';

interface Props {
  data: {
    title: string;
    description: string;
    lead: string;
    curveTitle?: string;
    curveCaption?: string;
    expressions: string[];
    reasons: { title: string; detail: string }[];
    record: { title: string; detail: string }[];
    forVisit: string[];
    faq: { q: string; a: string }[];
    related: { label: string; href: string | null; note?: string }[];
  };
  category: { title: string };
  curve?: CurveData;
  /**
   * 이 글이 연재의 한 편일 때만 넘어온다 (content.config.ts 의 learn.series 참고).
   * 넘어오면 breadcrumb 이 시리즈 이름을 함께 보여주고, 본문 앞뒤로 목차와
   * 이전/다음 이동이 붙는다.
   */
  series?: {
    title: string;
    items: SeriesItemView[];
    prev: SeriesItemView | null;
    next: SeriesItemView | null;
    /** series.json의 키(예: "pharmacology")와 지금 글의 slug. GA 이벤트에만 쓰인다. */
    key: string;
    currentSlug: string;
  };
}

const { data, category, curve, series } = Astro.props;
const related = data.related.map((r) => ({ ...r, href: r.href ? url(r.href) : null }));
const crumb = series ? `배우기 · ${series.title}` : `배우기 · ${category.title}`;
---
<BaseLayout title={data.title} description={data.description}>
  <PageHead
    crumb={crumb}
    crumbHref={url('/learn/')}
    title={data.title}
    lead={data.lead}
  />

  <div class="container">
    {series && (
      <div style="margin-bottom: var(--sp-10); max-width: var(--w-prose)">
        <SeriesToc title={series.title} items={series.items} />
      </div>
    )}

    {curve ? (
      <section class="concept__section" aria-labelledby="s-graph">
        <h2 id="s-graph">그래프로 보면</h2>
        <DayCurve
          curve={curve}
          variant="full"
          title={data.curveTitle ?? `${data.title} 예시 곡선`}
          caption={data.curveCaption}
        />
        <div class="prose" style="margin-top: var(--sp-8)">
          <slot />
        </div>
      </section>
    ) : (
      <div class="prose">
        <slot />
      </div>
    )}

    {data.expressions.length > 0 && (
      <section class="concept__section" aria-labelledby="s-expr">
        <h2 id="s-expr">이렇게 말하는 경우가 많습니다</h2>
        <ul class="quotes">
          {data.expressions.map((e) => <li>{e}</li>)}
        </ul>
      </section>
    )}

    {data.reasons.length > 0 && (
      <section class="concept__section" aria-labelledby="s-reason">
        <h2 id="s-reason">왜 그럴 수 있는가</h2>
        <div class="prose">
          <p>
            아래는 이 상황과 관련해 자주 함께 이야기되는 이유입니다. 어느 하나로 확정하는 목록이 아니며,
            여러 가지가 겹쳐 나타나는 경우가 많습니다.
          </p>
        </div>
        <ul class="checklist" style="margin-top: var(--sp-6)">
          {data.reasons.map((r) => (
            <li>
              <strong>{r.title}</strong>
              <span>{r.detail}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {data.record.length > 0 && (
      <section class="concept__section" aria-labelledby="s-record">
        <h2 id="s-record">며칠만 이렇게 기록해 보면</h2>
        <ul class="checklist">
          {data.record.map((r) => (
            <li>
              <strong>{r.title}</strong>
              <span>{r.detail}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {data.forVisit.length > 0 && (
      <section class="concept__section" aria-labelledby="s-visit">
        <h2 id="s-visit">치료진과 상의할 때 보여줄 수 있는 항목</h2>
        <Callout>
          <ul>
            {data.forVisit.map((v) => <li>{v}</li>)}
          </ul>
        </Callout>
        <p class="graph__caption" style="margin-top: var(--sp-4); max-width: var(--w-prose)">
          기록은 상황을 설명하기 위한 자료입니다. 약의 종류·용량·복용 시간, 식사나 생활 습관을 바꾸는 문제는
          담당 치료진과 상의해 주세요.
        </p>
      </section>
    )}

    {data.faq.length > 0 && (
      <section class="concept__section" aria-labelledby="s-faq">
        <h2 id="s-faq">자주 묻는 것</h2>
        <div style="max-width: var(--w-prose)">
          <FAQ items={data.faq} />
        </div>
      </section>
    )}

    {related.length > 0 && <RelatedContent items={related} />}

    {series && (
      <PrevNextNav prev={series.prev} next={series.next} seriesName={series.key} currentArticle={series.currentSlug} />
    )}

    <section class="concept__section" aria-labelledby="s-cta">
      <h2 id="s-cta" class="sr-only">기록 시작하기</h2>
      <Callout tone="plain">
        <p class="callout__title">읽고 나서 할 수 있는 일</p>
        <p>여기까지 읽었다면, 오늘부터 며칠만 복용 시각과 달라지기 시작한 시각을 남겨 보세요. 하루치보다 며칠치가 훨씬 많은 것을 알려줍니다.</p>
        <p style="margin-top: var(--sp-6)">
          <Button href={url('/start/')}>약효일지 시작하기</Button>
        </p>
      </Callout>
    </section>
  </div>
</BaseLayout>

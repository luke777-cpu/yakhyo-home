---
/**
 * "약효 이해하기" 개념 페이지의 공통 틀.
 * 순서는 모든 글에서 동일하다. 글마다 구성을 바꾸지 않는 것이 이 층의 목적이다.
 *   1 한 줄 정의 → 2 그래프로 보면 → 3 흔히 느끼는 표현 → 4 가능한 원인
 *   → 5 기록할 것 → 6 치료진에게 보여줄 때 → 7 관련 글 → 8 관련 영상
 */
import BaseLayout from './BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import DayCurve from '../components/DayCurve.astro';
import Callout from '../components/Callout.astro';
import RelatedContent from '../components/RelatedContent.astro';
import Button from '../components/Button.astro';
import { url } from '../lib/url';
import type { CurveData } from '../lib/curve';

interface Props {
  data: {
    title: string;
    term: string;
    description: string;
    definition: string;
    curveTitle?: string;
    curveCaption?: string;
    expressions: string[];
    causes: string[];
    record: { title: string; detail: string }[];
    forVisit: string[];
    related: { label: string; href: string | null; note?: string }[];
  };
  curve?: CurveData;
}

const { data, curve } = Astro.props;
const related = data.related.map((r) => ({ ...r, href: r.href ? url(r.href) : null }));
---
<BaseLayout title={`${data.title} (${data.term})`} description={data.description}>
  <PageHead crumb="약효 이해하기" crumbHref={url('/understand/')} title={data.title}>
    <p class="concept__meta"><span class="badge badge--soft">{data.term}</span></p>
    <p class="concept__definition">{data.definition}</p>
  </PageHead>

  <div class="container">
    {curve && (
      <section class="concept__section" aria-labelledby="s-graph">
        <h2 id="s-graph">그래프로 보면</h2>
        <DayCurve
          curve={curve}
          variant="full"
          title={data.curveTitle ?? `${data.title} 예시 곡선`}
          caption={data.curveCaption}
        />
        <div class="prose" style="margin-top: var(--sp-8)">
          <slot />
        </div>
      </section>
    )}

    {data.expressions.length > 0 && (
      <section class="concept__section" aria-labelledby="s-expr">
        <h2 id="s-expr">이렇게 표현하는 경우가 많습니다</h2>
        <ul class="quotes">
          {data.expressions.map((e) => <li>{e}</li>)}
        </ul>
      </section>
    )}

    {data.causes.length > 0 && (
      <section class="concept__section" aria-labelledby="s-cause">
        <h2 id="s-cause">함께 이야기되는 요인</h2>
        <div class="prose">
          <p>
            아래는 이 현상과 관련해 자주 함께 이야기되는 요인입니다. 원인을 확정하는 목록이 아니며,
            여러 가지가 겹쳐 나타나는 경우가 많습니다.
          </p>
          <ul>
            {data.causes.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </section>
    )}

    {data.record.length > 0 && (
      <section class="concept__section" aria-labelledby="s-record">
        <h2 id="s-record">이런 패턴에서 함께 기록하면 도움이 되는 정보</h2>
        <ul class="checklist">
          {data.record.map((r) => (
            <li>
              <strong>{r.title}</strong>
              <span>{r.detail}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {data.forVisit.length > 0 && (
      <section class="concept__section" aria-labelledby="s-visit">
        <h2 id="s-visit">치료진과 상의할 때 보여줄 수 있는 항목</h2>
        <Callout>
          <ul>
            {data.forVisit.map((v) => <li>{v}</li>)}
          </ul>
        </Callout>
        <p class="graph__caption" style="margin-top: var(--sp-4); max-width: var(--w-prose)">
          기록은 상황을 설명하기 위한 자료입니다. 약의 종류·용량·복용 시간에 대한 판단은 담당 치료진과 상의해 주세요.
        </p>
      </section>
    )}

    {related.length > 0 && <RelatedContent items={related} />}

    <section class="concept__section" aria-labelledby="s-video">
      <h2 id="s-video">관련 영상</h2>
      <p class="section__lead">이 주제를 다룬 영상은 준비 중입니다.</p>
    </section>

    <section class="concept__section" aria-labelledby="s-cta">
      <h2 id="s-cta" class="sr-only">기록 시작하기</h2>
      <Callout tone="plain">
        <p class="callout__title">이 패턴이 익숙하다면</p>
        <p>복용 시각과 달라지기 시작한 시각을 며칠만 남겨 보세요. 하루치보다 며칠치가 훨씬 많은 것을 알려줍니다.</p>
        <p style="margin-top: var(--sp-6)">
          <Button href={url('/start/')}>약효일지 시작하기</Button>
        </p>
      </Callout>
    </section>
  </div>
</BaseLayout>

---
/** 영문 섹션의 푸터. 바깥 링크 목록은 한국어 쪽과 같은 links.json 을 함께 쓴다. */
import { EN_NAV, EN_SITE, EN_MEDICAL_NOTICE, EN_GA_NOTICE } from '../lib/en';
import links from '../data/links.json';
import { url } from '../lib/url';

const year = 2026;
const gaEnabled = Boolean(import.meta.env.PUBLIC_GA_MEASUREMENT_ID) && import.meta.env.PROD;
const external = [
  links.app ? { href: links.app, label: 'Open the app in a browser' } : null,
  links.playStore ? { href: links.playStore, label: 'Google Play' } : null,
  links.youtube ? { href: links.youtube, label: 'YouTube channel' } : null,
].filter(Boolean) as { href: string; label: string }[];
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <p class="footer__title">{EN_SITE.name}</p>
        <p>{EN_SITE.tagline}</p>
      </div>

      <nav aria-label="Site menu">
        <p class="footer__title">Browse</p>
        <ul class="footer__list">
          {EN_NAV.map((item) => (
            <li><a href={url(item.href)}>{item.label}</a></li>
          ))}
          <li><a href={url('/')} lang="ko">한국어 페이지로</a></li>
        </ul>
      </nav>

      {external.length > 0 && (
        <div>
          <p class="footer__title">Elsewhere</p>
          <ul class="footer__list">
            {external.map((item) => (
              <li><a href={item.href} rel="noopener" target="_blank">{item.label}<span class="sr-only">(opens in a new window)</span></a></li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="footer__bottom">
      <p class="footer__notice">{EN_MEDICAL_NOTICE}</p>
      {gaEnabled && <p class="footer__notice">{EN_GA_NOTICE}</p>}
      <p>© {year} {EN_SITE.koreanName} ({EN_SITE.name})</p>
    </div>
  </div>
</footer>

---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[]; }
const { items } = Astro.props;
---
<ul class="faq">
  {items.map((item) => (
    <li>
      <details class="faq__item">
        <summary class="faq__q">
          {item.q}
          <Icon name="plus" size={18} class="faq__icon" />
        </summary>
        <p class="faq__a">{item.a}</p>
      </details>
    </li>
  ))}
</ul>

---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  block?: boolean;
  external?: boolean;
  /** 새 창으로 열린다는 화면낭독기용 안내. 영문 섹션에서만 다른 값을 넘긴다. */
  externalLabel?: string;
  class?: string;
}
const {
  href,
  variant = 'primary',
  block = false,
  external = false,
  externalLabel = '(새 창)',
  class: className = '',
} = Astro.props;
const rel = external ? 'noopener' : undefined;
const target = external ? '_blank' : undefined;
---
<a
  class={`btn btn--${variant} ${block ? 'btn--block' : ''} ${className}`}
  href={href}
  rel={rel}
  target={target}
>
  <slot />
  {external && <span class="sr-only">{externalLabel}</span>}
</a>

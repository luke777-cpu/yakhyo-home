---
import Icon from './Icon.astro';
interface Props {
  title?: string;
  items: { label: string; href?: string | null; note?: string; external?: boolean }[];
}
const { title = '관련 글', items } = Astro.props;
---
<nav class="related" aria-label={title}>
  <h2 class="section__title">{title}</h2>
  <ul class="rowlink-list" style="margin-top: var(--sp-6)">
    {items.map((item) => (
      <li>
        {item.href ? (
          <a class="rowlink" href={item.href} rel={item.external ? 'noopener' : undefined} target={item.external ? '_blank' : undefined}>
            <span class="rowlink__text">
              {item.label}
              {item.note && <span class="rowlink__hint">{item.note}</span>}
            </span>
            <Icon name={item.external ? 'arrow-up-right' : 'arrow-right'} size={18} class="rowlink__arrow" />
          </a>
        ) : (
          <span class="rowlink">
            <span class="rowlink__text">
              {item.label}
              {item.note && <span class="rowlink__hint">{item.note}</span>}
            </span>
            <span class="badge">준비 중</span>
          </span>
        )}
      </li>
    ))}
  </ul>
</nav>

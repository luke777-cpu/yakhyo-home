---
/**
 * "글" 게시판 글 하단의 안전 고지.
 * 개인 경험 글과 논문 요약 글이 문구가 달라야 해서 type으로 분기하되,
 * 매 페이지 다른 문구를 새로 적지 않도록 한 곳에 모아 둔다.
 */
interface Props { type: 'personal' | 'paper' }
const { type } = Astro.props;
const text =
  type === 'paper'
    ? '연구결과를 이해하기 쉽게 요약한 글이며 개인에 대한 의료 조언이 아닙니다.'
    : '이 글은 개인의 약효 기록과 경험을 정리한 것입니다. 개인별 약물 반응과 적절한 복용법은 다를 수 있으며, 약물 변경은 담당 의료진과 상의해야 합니다.';
---
<p class="graph__caption" style="max-width: var(--w-prose); margin-top: var(--sp-8)">{text}</p>

# 약효일지 홈페이지 — 인증/게시판 환경변수 (Firebase)
#
# 이 파일을 복사해 .env 로 만들고 값을 채운다.
#   PowerShell:  Copy-Item .env.example .env
#
# .env 는 커밋하지 않는다(.gitignore 에 이미 있다).
# 값을 구하는 방법은 docs/FIREBASE-AUTH-BOARD-SETUP.md 1~2단계.

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Google Analytics 를 쓸 때만 필요하다. 이번 v1 에서는 쓰지 않으므로 비워 두어도 된다.
PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------
# 위 값들은 Firebase 의 **web config** 다. 비밀키가 아니라 프로젝트를 가리키는
# 식별자이고, 브라우저에 나가는 것이 정상이다. 접근 제어는 이 값이 아니라
# firestore.rules 가 한다.
#
# 반대로 **service account JSON / private key 는 절대 여기 넣지 않는다.**
# 그 키는 Rules 를 통째로 무시하므로 브라우저에 나가면 안 된다.
# 나중에 카카오 로그인을 붙일 때 서버(Cloud Functions)에서만 쓴다.
# ---------------------------------------------------------------

# 배포 대상 (로컬에서는 비워 두면 기본값을 쓴다)
# SITE_URL=https://luke777-cpu.github.io
# BASE_PATH=/yakhyo-home

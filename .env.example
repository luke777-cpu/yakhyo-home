# 약효일지 홈페이지 — 인증/게시판 환경변수
#
# 이 파일을 복사해 .env 로 만들고 값을 채운다.
#   cp .env.example .env
#
# .env 는 커밋하지 않는다(.gitignore 에 이미 있다).
# 값을 구하는 방법은 docs/AUTH-BOARD-SETUP.md 1~2단계.

# Supabase 프로젝트 URL  (예: https://abcdefghijklm.supabase.co)
PUBLIC_SUPABASE_URL=

# Supabase anon / public key
# 브라우저로 나가는 것이 정상인 키다. 접근 제어는 이 키가 아니라 RLS 가 한다.
PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# service_role key 는 여기에도, 코드 어디에도 두지 않는다.
# 그 키는 RLS 를 통째로 무시하므로 브라우저에 나가면 안 된다.
# ---------------------------------------------------------------

# 배포 대상 (로컬에서는 비워 두면 기본값을 쓴다)
# SITE_URL=https://luke777-cpu.github.io
# BASE_PATH=/yakhyo-home
